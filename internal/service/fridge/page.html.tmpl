<!DOCTYPE html>
<html lang="{{.Lang}}" dir="{{if .Hebrew}}rtl{{else}}ltr{{end}}"><head>
<meta charset="UTF-8">
<title>{{.Location}} - {{.Year}} Shabbat Times - Hebcal</title>
<meta name="robots" content="noindex, nofollow">
<style>
html{line-height:1.15;-webkit-text-size-adjust:100%;text-size-adjust:100%}body{margin:0}[type=checkbox]{box-sizing:border-box;padding:0}
</style>
{{if .Hebrew -}}
<style>
@font-face {
  font-family: 'Adobe Hebrew';
  src: url(/i/adobehebrew-regular.woff2) format('woff2');
  font-style: normal;
  font-weight: normal;
  font-display: swap;
}
@font-face {
  font-family: 'Adobe Hebrew';
  src: url(/i/adobehebrew-bold.woff2) format('woff2');
  font-style: normal;
  font-weight: bold;
  font-display: swap;
}
</style>
{{- else -}}
<link href="https://fonts.googleapis.com/css2?family=Open+Sans+Condensed:wght@300;700&family=Open+Sans:wght@300;600&display=swap" rel="stylesheet">
{{- end}}
<style>
body {font-family:{{if .Hebrew}}'Adobe Hebrew'{{else}}'Open Sans'{{end}}, sans-serif}
.container {
  width: 100%;
  padding-right: 1rem;
  padding-left: 1rem;
  margin-right: auto;
  margin-left: auto;
}
.text-center {text-align:center}
h3 {
  font-weight: {{if .Hebrew}}700{{else}}600{{end}};
  font-size: calc(1.275rem + 0.3vw);
  margin:24px 0 0;
}
table {border-spacing: 0; border-collapse: collapse; margin-left: auto; margin-right: auto;}
#fridge-table td {padding: 0px 4px;}
#fridge-table td.leftpad {padding: 0 0 0 12px;}
#fridge-table td.rightpad {padding: 0 12px 0 0;}
#fridge-table :lang(he){font-size:large}
.text-right {text-align: right;}
.yomtov { font-weight:{{if .Hebrew}}700{{else}}600{{end}}}
.narrow { font-family: 'Open Sans Condensed', sans-serif }
.havdalah {display:none}
.nowrap {white-space: nowrap !important;}
@media print{
 a[href]:after{content:""}
 .nav {display:none}
}
</style>
</head>
<body>
<div class="container">
<h3 class="text-center">{{.CandleLighting}} - {{.ShortLocation}}
<br>
<span lang="en" dir="ltr">{{.Heading}}</span>
</h3>
<p class="text-center" style="margin:0 0 4px">www.hebcal.com</p>
<table style="width:524px" id="fridge-table">
<colgroup>
<col><col><col><col><col class="havdalah">
<col style="border-right:1px solid #999">
<col><col><col><col><col class="havdalah">
</colgroup>
<tbody>
{{range .Rows -}}
<tr>{{template "cell" .Left}}
<td></td>
{{template "cell" .Right}}</tr>
{{end -}}
</tbody></table>
<div dir="ltr" class="text-center" style="margin-top: 0.75rem">
{{if not .Havdalah.None -}}
<form class="nav">
  <input type="checkbox" style="width:1.25rem; height:1.25rem; vertical-align: middle" id="toggle-havdalah">
  <label for="toggle-havdalah" style="vertical-align: middle">Show Havdalah times</label>
</form>
{{end -}}
<table style="width:524px" id="fridge-nav" data-base="{{.BaseURL}}">
<tbody>
<tr>
<td class="nav">{{with .Nav.PrevHeb}}
  <p><a class="nowrap" rel="nofollow" title="Previous Hebrew year"
  data-year="{{.}}">&larr; {{.}}</a></p>
{{end}}{{with .Nav.PrevGreg}}
  <p><a class="nowrap" rel="nofollow" title="Previous Gregorian year"
  data-year="{{.}}" data-yt="G">&larr; {{.}}</a></p>
{{end}}</td>
<td class="text-center" style="padding: 0px 8px">
<div><p>Candle-lighting times are {{if .CandleMins}}{{.CandleMins}} min before{{else}}at{{end}} sunset</p></div>
{{if not .Havdalah.None -}}
<div id="havdalah-footer" class="havdalah"><p>Havdalah times are
{{if .Havdalah.Minutes}}{{.Havdalah.Minutes}} min after sunset{{else}}for 3 stars (sun {{.Havdalah.Degrees}}° below the horizon){{end}}
</p></div>
{{end -}}
</td>
<td class="nav">{{with .Nav.NextHeb}}
  <p><a class="nowrap" rel="nofollow" title="Next Hebrew year"
  data-year="{{.}}">{{.}} &rarr;</a></p>
{{end}}{{with .Nav.NextGreg}}
  <p><a class="nowrap" rel="nofollow" title="Next Gregorian year"
  data-year="{{.}}" data-yt="G">{{.}} &rarr;</a></p>
{{end}}</td>
</tr>
</tbody>
</table>
</div>
</div><!-- .container -->
<script nonce="{{.Nonce}}">
document.addEventListener('DOMContentLoaded', function() {
  // Set prev/next year hrefs here rather than in the HTML to keep crawlers from following them
  const navTable = document.getElementById('fridge-nav');
  const baseUrl = navTable.getAttribute('data-base');
  [].slice.call(navTable.querySelectorAll('a[data-year]')).forEach(function (a) {
    let href = baseUrl + '&year=' + a.getAttribute('data-year');
    const yt = a.getAttribute('data-yt');
    if (yt) {
      href += '&yt=' + yt;
    }
    a.setAttribute('href', href);
  });
  const havdalahTd = [].slice.call(document.querySelectorAll('td.havdalah'));
  const havdalahCol = [].slice.call(document.querySelectorAll('col.havdalah'));
  const checkbox = document.getElementById('toggle-havdalah');
  const fridgeTable = document.getElementById('fridge-table');
  const havdalahFooter = document.getElementById('havdalah-footer');
  if (!checkbox) {
    return;
  }
  checkbox.addEventListener('change', function() {
    if (this.checked) {
      fridgeTable.style.width = '620px';
      havdalahTd.forEach(function (el) {el.style.display = 'table-cell';});
      havdalahCol.forEach(function (el) {el.style.display = 'table-column';});
      havdalahFooter.style.display = 'block';
    } else {
      fridgeTable.style.width = '524px';
      havdalahTd.forEach(function (el) {el.style.display = 'none';});
      havdalahCol.forEach(function (el) {el.style.display = 'none';});
      havdalahFooter.style.display = 'none';
    }
  });
});
</script>
</body>
</html>
{{- define "cell" -}}
{{if . -}}
<td{{with .MonthClass}} class="{{.}}"{{end}}>{{.Month}}</td><td class="{{.DayClass}}">{{.Day}}</td><td{{with .ReasonClass}} class="{{.}}"{{end}}>{{.Reason}}</td><td class="{{.TimeClass}}">{{.Time}}</td><td class="{{.TimeClass}} havdalah">{{.Havdalah}}</td>
{{- else -}}
<td></td><td></td><td></td><td></td><td></td>
{{- end}}
{{- end}}
